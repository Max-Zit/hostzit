[Unit]
Description=HostZit firewall tables (no direct mail from websites, blocked addresses, country rule of the sign-in services)
After=nftables.service network-pre.target
Wants=network-pre.target
ConditionPathExists=/etc/hostzit/firewall.nft

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/hostzit/firewall.nft
ExecStart=/bin/sh -c "[ ! -f /etc/hostzit/geo.nft ] || /usr/sbin/nft -f /etc/hostzit/geo.nft"

[Install]
WantedBy=multi-user.target
