[Unit]
Description=HostZit root helper (privileged operations of the panel)
After=local-fs.target network.target
Before=hostzit-server.service

[Service]
ExecStart=/usr/lib/hostzit/hostzit-helper
Restart=on-failure
RestartSec=2s
# A stop reaches only the helper itself: it finishes the operations in
# flight (up to 20 seconds) with their programs (nginx -t, systemctl,
# networkctl), so an update or a reboot never cuts a change in half.
KillMode=mixed
TimeoutStopSec=45s
RuntimeDirectory=hostzit
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
# No options that give the helper its own mount namespace: the cages it
# mounts must be visible to the whole system (PHP, SSH, cron).
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
